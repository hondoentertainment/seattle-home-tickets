# Copy to .env.local for local Google sign-in. Never commit real values.

# Required for real sign-in. Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth Web client (either pair works)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Set AUTH_URL on Vercel Production ONLY:
#   AUTH_URL=https://seattle-home-tickets.vercel.app
# Local optional:
#   AUTH_URL=http://localhost:3000
# Leave AUTH_URL unset on Vercel Preview so Auth.js infers the host.
# AUTH_URL=

# Saved account sync (optional). Without these, Google login still works;
# Saved stays in this browser.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# DATABASE_URL=
# POSTGRES_URL=

# Optional. Lets the header Refresh icon queue .github/workflows/daily-refresh.yml
# via workflow_dispatch. Without it, Refresh still reloads the page and shows the
# last-checked stamp — it will not pretend a catalog rebuild happened.
# Fine-grained PAT: Actions = Read and write. Classic: public_repo + workflow
# (or repo if the project is private). Store on Vercel Production only.
# GH_REFRESH_TOKEN=

# Alerts stay in-app (and optional Redis/Neon if the user is signed in).
# Email / web-push are not sent. Do not add VAPID or Resend keys expecting delivery.
