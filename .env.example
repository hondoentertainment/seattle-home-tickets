# Auth.js (next-auth v5). Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth (either pair works)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: Vercel Preview + production host inference
# AUTH_TRUST_HOST=true

# Saved sync — prefer Upstash Redis. Neon is the fallback if DATABASE_URL is set.
# Without either, Google sign-in still works; Saved stays on this device.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# DATABASE_URL=
# POSTGRES_URL=
